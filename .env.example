# PostgreSQL (Neon / Supabase / Railway / local). Orders are only persisted when this is set.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/khomra?sslmode=require"

# NextAuth v5 — generate with: npx auth secret
AUTH_SECRET="generate-a-long-random-secret"
# Public URL of the app. Required in production. Local dev runs on port 3020.
AUTH_URL="http://localhost:3020"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin: <AUTH_URL>
# Authorized redirect URI:      <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Order confirmation emails (optional — orders still work without it)
RESEND_API_KEY=""
EMAIL_FROM="Khomra <orders@your-verified-domain.com>"

# This account is promoted to ADMIN automatically the moment it signs in with Google.
ADMIN_EMAIL=""

NEXT_PUBLIC_INSTAPAY_ADDRESS="khomra@instapay"
